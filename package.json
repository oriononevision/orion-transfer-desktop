{
  "name": "orion-transfer-desktop",
  "productName": "ORION Transfer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ORION Transfer — application bureau (fichiers, dossiers, code partagé natif)",
  "author": "ORION",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5176 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "icons": "node scripts/make-icons.mjs",
    "publish:web": "node scripts/copy-installer.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.5",
    "to-ico": "^1.1.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.orion.transfer.desktop",
    "productName": "ORION Transfer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "ORION-Transfer-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "ORION-Transfer-${version}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
